# Copy to .env and fill in your keys. Never commit .env.

# REQUIRED: free email signup at https://console.groq.com/keys (no credit card).
# Class default model is llama-3.3-70b-versatile on Groq.
# Free tier (Apr 2026) = 30 requests/minute, 14,400 requests/day. Groq runs on
# custom LPU hardware: sub-second first-token latency, OpenAI-compatible API.
GROQ_API_KEY=

# OPTIONAL: fallback free provider. Sign up at https://openrouter.ai/keys.
# Useful when you want to compare Qwen3, GPT-OSS, Llama, GLM in the same client.
# Free tier is 20 RPM / 50 RPD per model and can be throttled at peak hours.
OPENROUTER_API_KEY=

# OPTIONAL: only needed for Ex 5. Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OPTIONAL: Gemini swap. Free at https://aistudio.google.com/apikey
# Note: Gemini free tier is only 20 RPD per model (Apr 2026 post-cuts), which
# is why this is no longer a class default. Useful for provider comparison.
GOOGLE_API_KEY=

# OPTIONAL: Ex 4 observability. Free at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=w10-hands-on
